<Window x:Class="AsyncTaskManagerWpf.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Width="400"
        Height="220"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- 공통 색상 -->
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F5F1F8"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FCFBFE"/>
        <SolidColorBrush x:Key="SoftPanelBrush" Color="#F2EEF8"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E8E0F0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1A3A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7F7B99"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6C63FF"/>
        <SolidColorBrush x:Key="AccentBrush2" Color="#8B6EF3"/>

        <LinearGradientBrush x:Key="PurpleButtonBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#5F62F3" Offset="0"/>
            <GradientStop Color="#8C6CF5" Offset="1"/>
        </LinearGradientBrush>

        
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource PurpleButtonBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="AnimatedRoundedButtonStyle"
                    TargetType="Button"
                    BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                     To="1.06"
                                     Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                     To="1.06"
                                     Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                     To="1.0"
                                     Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                     To="1.0"
                                     Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    
    <Border Background="White"
            BorderBrush="#DDD6F3"
            BorderThickness="1"
            CornerRadius="20">

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="68"/>
            </Grid.RowDefinitions>

            <!-- 타이틀바 -->
            <Border Grid.Row="0"
                    Background="#6C63FF"
                    CornerRadius="20,20,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleText"
                               Text="알림"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <Button Grid.Column="1"
                            Content="✕"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="13"
                            Cursor="Hand"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- 메시지 영역 -->
            <Grid Grid.Row="1" Margin="22,14,22,8">
                <TextBlock x:Name="MessageText"
                           Text="메시지"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#1B1A3A"
                           FontSize="16"
                           LineHeight="24"/>
            </Grid>

            <!-- 버튼 영역 -->
            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Content="확인"
                            Width="96"
                            Height="40"
                            Margin="5,0,5,0"
                            Style="{StaticResource AnimatedRoundedButtonStyle}"
                            Click="Ok_Click"/>

                    <Button x:Name="CancelButton"
                            Content="취소"
                            Width="96"
                            Height="40"
                            Visibility="Collapsed"
                            Style="{StaticResource AnimatedRoundedButtonStyle}"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>